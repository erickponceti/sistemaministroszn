# Copie este arquivo para .env e preencha. O .env NÃO vai para o GitHub.

PORT=3000
SESSION_SECRET=troque_por_uma_frase_secreta_longa
BASE_URL=http://localhost:3000

# --- Opção 1: banco na nuvem (Neon) — use no servidor web ---
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=verify-full

# --- Opção 2: banco local (PostgreSQL no computador) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smzn
DB_USER=postgres
DB_PASSWORD=

# Opcional: e-mail (redefinição de senha)
EMAIL_USER=
EMAIL_PASS=
EMAIL_ADMIN=

# Opcional: Telegram (envio das escalas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_TESTE=
