<%- include('../partials/header', {page: filtros.tipo === 'cliente' ? 'clientes' : filtros.tipo === 'fornecedor' ? 'fornecedores' : 'empresas'}) %>

<div class="page-header">
  <div class="page-header-left">
    <h1><i class="fas fa-users" style="color:var(--primary)"></i> Cadastros</h1>
    <p>Clientes, fornecedores e empresas parceiras</p>
  </div>
  <div class="page-header-actions">
    <a href="/pessoas/novo?tipo=cliente" class="btn btn-primary"><i class="fas fa-user-plus"></i> Novo Cliente</a>
    <a href="/pessoas/novo?tipo=fornecedor" class="btn btn-outline"><i class="fas fa-truck"></i> Fornecedor</a>
    <a href="/pessoas/novo?tipo=empresa" class="btn btn-outline"><i class="fas fa-building"></i> Empresa</a>
  </div>
</div>

<form class="filter-bar" method="GET" action="/pessoas">
  <input type="text" name="busca" placeholder="🔍 Buscar por nome, CPF/CNPJ ou e-mail..." value="<%= filtros.busca || '' %>">
  <select name="tipo">
    <option value="">Todos os tipos</option>
    <option value="cliente" <%= filtros.tipo === 'cliente' ? 'selected' : '' %>>👤 Clientes</option>
    <option value="fornecedor" <%= filtros.tipo === 'fornecedor' ? 'selected' : '' %>>🚚 Fornecedores</option>
    <option value="empresa" <%= filtros.tipo === 'empresa' ? 'selected' : '' %>>🏢 Empresas</option>
  </select>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filtrar</button>
  <a href="/pessoas" class="btn btn-outline btn-sm"><i class="fas fa-times"></i> Limpar</a>
</form>

<div class="table-wrapper">
  <% if (pessoas.length === 0) { %>
  <div class="empty-state"><i class="fas fa-users"></i><p>Nenhum cadastro encontrado. <a href="/pessoas/novo">Adicionar agora</a></p></div>
  <% } else { %>
  <table>
    <thead><tr><th>Tipo</th><th>Nome</th><th>CPF / CNPJ</th><th>Telefone</th><th>WhatsApp</th><th>Cidade</th><th>Ações</th></tr></thead>
    <tbody>
      <% pessoas.forEach(p => { %>
      <tr>
        <td><span class="badge badge-<%= p.tipo %>"><%= p.tipo === 'cliente' ? '👤' : p.tipo === 'fornecedor' ? '🚚' : '🏢' %> <%= p.tipo.charAt(0).toUpperCase() + p.tipo.slice(1) %></span></td>
        <td><strong><%= p.nome %></strong></td>
        <td><%= p.cpf_cnpj || '—' %></td>
        <td><%= p.telefone || '—' %></td>
        <td>
          <% if (p.whatsapp) { %>
          <a href="https://wa.me/55<%= p.whatsapp.replace(/\D/g,'') %>" target="_blank" class="btn btn-whatsapp btn-sm">
            <i class="fab fa-whatsapp"></i> <%= p.whatsapp %>
          </a>
          <% } else { %>—<% } %>
        </td>
        <td><%= p.cidade ? p.cidade + (p.estado ? '/' + p.estado : '') : '—' %></td>
        <td>
          <div style="display:flex;gap:4px;">
            <a href="/pessoas/<%= p.id %>/editar" class="btn btn-outline btn-sm btn-icon"><i class="fas fa-edit"></i></a>
            <form action="/pessoas/<%= p.id %>?_method=DELETE" method="POST" style="display:inline;">
              <button type="button" class="btn btn-danger btn-sm btn-icon" onclick="confirmDelete(this.closest('form'),'Inativar este cadastro?')"><i class="fas fa-trash"></i></button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
