<%- include('../partials/header', {page:'veiculos'}) %>

<div class="breadcrumb">
  <a href="/veiculos"><i class="fas fa-car"></i> Veículos</a>
  <i class="fas fa-chevron-right"></i>
  <span><%= veiculo ? 'Editar Veículo' : 'Novo Veículo' %></span>
</div>

<div class="page-header">
  <div class="page-header-left">
    <h1><i class="fas fa-<%= veiculo ? 'edit' : 'plus-circle' %>" style="color:var(--primary)"></i> <%= veiculo ? 'Editar Veículo' : 'Cadastrar Veículo' %></h1>
  </div>
</div>

<form action="/veiculos<%= veiculo ? '/' + veiculo.id + '?_method=PUT' : '' %>" method="POST">
  <div class="card" style="margin-bottom:20px;">
    <div class="card-header">
      <div class="card-title"><i class="fas fa-info-circle"></i> Informações Básicas</div>
    </div>
    <div class="card-body">
      <div class="form-row form-row-3">
        <div class="form-group">
          <label>Tipo <span class="req">*</span></label>
          <select name="tipo" required>
            <option value="carro" <%= veiculo?.tipo === 'carro' ? 'selected' : '' %>>🚗 Carro</option>
            <option value="moto" <%= veiculo?.tipo === 'moto' ? 'selected' : '' %>>🏍️ Moto</option>
          </select>
        </div>
        <div class="form-group">
          <label>Placa <span class="req">*</span></label>
          <input type="text" name="placa" value="<%= veiculo?.placa || '' %>" placeholder="AAA-0000" required maxlength="8" style="text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="disponivel" <%= (!veiculo || veiculo?.status === 'disponivel') ? 'selected' : '' %>>Disponível</option>
            <option value="alugado" <%= veiculo?.status === 'alugado' ? 'selected' : '' %>>Alugado</option>
            <option value="manutencao" <%= veiculo?.status === 'manutencao' ? 'selected' : '' %>>Manutenção</option>
            <option value="inativo" <%= veiculo?.status === 'inativo' ? 'selected' : '' %>>Inativo</option>
          </select>
        </div>
        <div class="form-group">
          <label>Marca <span class="req">*</span></label>
          <input type="text" name="marca" value="<%= veiculo?.marca || '' %>" placeholder="Ex: Toyota" required>
        </div>
        <div class="form-group">
          <label>Modelo <span class="req">*</span></label>
          <input type="text" name="modelo" value="<%= veiculo?.modelo || '' %>" placeholder="Ex: Corolla" required>
        </div>
        <div class="form-group">
          <label>Cor</label>
          <input type="text" name="cor" value="<%= veiculo?.cor || '' %>" placeholder="Ex: Prata">
        </div>
        <div class="form-group">
          <label>Ano Fabricação</label>
          <input type="number" name="ano_fabricacao" value="<%= veiculo?.ano_fabricacao || '' %>" placeholder="2022" min="1990" max="2030">
        </div>
        <div class="form-group">
          <label>Ano Modelo</label>
          <input type="number" name="ano_modelo" value="<%= veiculo?.ano_modelo || '' %>" placeholder="2023" min="1990" max="2030">
        </div>
        <div class="form-group">
          <label>Combustível</label>
          <select name="combustivel">
            <option value="flex" <%= veiculo?.combustivel === 'flex' ? 'selected' : '' %>>Flex</option>
            <option value="gasolina" <%= veiculo?.combustivel === 'gasolina' ? 'selected' : '' %>>Gasolina</option>
            <option value="diesel" <%= veiculo?.combustivel === 'diesel' ? 'selected' : '' %>>Diesel</option>
            <option value="eletrico" <%= veiculo?.combustivel === 'eletrico' ? 'selected' : '' %>>Elétrico</option>
            <option value="gas" <%= veiculo?.combustivel === 'gas' ? 'selected' : '' %>>GNV</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header">
      <div class="card-title"><i class="fas fa-file-alt"></i> Documentação e Financeiro</div>
    </div>
    <div class="card-body">
      <div class="form-row form-row-3">
        <div class="form-group">
          <label>RENAVAM</label>
          <input type="text" name="renavam" value="<%= veiculo?.renavam || '' %>" placeholder="00000000000">
        </div>
        <div class="form-group">
          <label>Chassi</label>
          <input type="text" name="chassi" value="<%= veiculo?.chassi || '' %>" placeholder="9BWHE21JX24060831">
        </div>
        <div class="form-group">
          <label>KM Atual</label>
          <input type="number" name="km_atual" value="<%= veiculo?.km_atual || '' %>" placeholder="0" min="0">
        </div>
        <div class="form-group">
          <label>Valor por Semana (R$)</label>
          <input type="number" name="valor_semanal" value="<%= veiculo?.valor_semanal || '' %>" placeholder="0,00" step="0.01" min="0">
        </div>
        <div class="form-group">
          <label>Proprietário</label>
          <select name="proprietario_id">
            <option value="">— Selecionar —</option>
            <% pessoas.forEach(p => { %>
            <option value="<%= p.id %>" <%= veiculo?.proprietario_id == p.id ? 'selected' : '' %>><%= p.nome %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-group" style="margin-top:12px;">
        <label>Observações</label>
        <textarea name="observacoes" rows="3" placeholder="Informações adicionais sobre o veículo..."><%= veiculo?.observacoes || '' %></textarea>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:10px;justify-content:flex-end;">
    <a href="/veiculos" class="btn btn-outline"><i class="fas fa-times"></i> Cancelar</a>
    <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save"></i> <%= veiculo ? 'Salvar Alterações' : 'Cadastrar Veículo' %></button>
  </div>
</form>

<%- include('../partials/footer') %>
