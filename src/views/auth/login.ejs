<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    html,body{height:100%;font-family:"Plus Jakarta Sans",sans-serif;}
    body{display:flex;min-height:100vh;}

    /* PAINEL ESQUERDO */
    .lp{
      flex:1;position:relative;overflow:hidden;
      display:flex;flex-direction:column;justify-content:flex-end;padding:48px;
      background:linear-gradient(150deg,#0D2542 0%,#1B3F6B 45%,#163560 75%,#0D2542 100%);
    }
    .lp::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(201,168,76,0.07) 1px,transparent 1px);background-size:26px 26px;}

    /* Decorativos */
    .dc{position:absolute;border-radius:50%;pointer-events:none;}
    .dc1{width:500px;height:500px;top:-160px;right:-120px;background:radial-gradient(circle,rgba(201,168,76,0.12) 0%,transparent 65%);}
    .dc2{width:300px;height:300px;bottom:60px;right:40px;background:radial-gradient(circle,rgba(27,63,107,0.6) 0%,transparent 70%);}
    .dc3{width:200px;height:200px;top:180px;left:-50px;background:radial-gradient(circle,rgba(201,168,76,0.08) 0%,transparent 70%);}

    /* Cards flutuantes */
    .sf{position:absolute;background:rgba(255,255,255,0.07);backdrop-filter:blur(10px);border:1px solid rgba(201,168,76,0.2);border-radius:14px;padding:11px 15px;display:flex;align-items:center;gap:10px;}
    .sf1{top:20%;left:7%;}
    .sf2{top:16%;right:7%;}
    .sf3{bottom:34%;right:6%;}
    .sf-ic{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
    .sf-v{font-size:15px;font-weight:800;color:#fff;line-height:1;}
    .sf-l{font-size:9.5px;color:rgba(255,255,255,0.5);margin-top:2px;}

    .fleet-svg{position:absolute;top:50%;left:50%;transform:translate(-50%,-54%);width:460px;height:300px;}

    /* Linha dourada decorativa */
    .gold-line{width:48px;height:3px;background:linear-gradient(90deg,#C9A84C,#E8C96A);border-radius:2px;margin-bottom:18px;}

    .lb{position:relative;z-index:2;}
    .lb-logo{width:90px;margin-bottom:18px;filter:brightness(1.1);}
    .tagline{font-size:30px;font-weight:800;color:#fff;line-height:1.2;letter-spacing:-0.5px;margin-bottom:10px;}
    .tagline span{background:linear-gradient(90deg,#C9A84C,#E8C96A);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
    .desc{font-size:13.5px;color:rgba(255,255,255,0.5);line-height:1.6;max-width:340px;}
    .feat-row{display:flex;gap:18px;margin-top:22px;flex-wrap:wrap;}
    .feat{font-size:11px;color:rgba(255,255,255,0.45);display:flex;align-items:center;gap:5px;}
    .feat i{color:#C9A84C;font-size:10px;}

    /* PAINEL DIREITO */
    .rp{width:480px;flex-shrink:0;background:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:52px;position:relative;overflow:hidden;}
    .rp::before{content:"";position:absolute;top:-100px;right:-100px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(27,63,107,0.04) 0%,transparent 70%);}
    .rp::after{content:"";position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#1B3F6B,#C9A84C,#1B3F6B);}

    .fw{width:100%;max-width:380px;position:relative;z-index:1;}

    /* Logo no form */
    .form-logo{width:110px;margin:0 auto 24px;display:block;}

    .form-title{font-size:24px;font-weight:800;color:#0D2542;letter-spacing:-0.5px;margin-bottom:5px;text-align:center;}
    .form-sub{font-size:13px;color:#64748B;margin-bottom:28px;text-align:center;line-height:1.5;}

    .alert{padding:11px 14px;border-radius:9px;margin-bottom:16px;display:flex;align-items:flex-start;gap:9px;font-size:13px;font-weight:500;border:1px solid transparent;}
    .alert-success{background:#ECFDF5;color:#059669;border-color:rgba(5,150,105,0.2);}
    .alert-danger{background:#FEF2F2;color:#DC2626;border-color:rgba(220,38,38,0.2);}

    .field{margin-bottom:16px;}
    .field label{display:block;font-size:11px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:0.6px;margin-bottom:6px;}
    .iw{position:relative;}
    .iw i.ico{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#B8CCE0;font-size:14px;pointer-events:none;transition:color 0.2s;}
    .iw input{width:100%;padding:12px 14px 12px 40px;border:1.5px solid #DDE6F0;border-radius:10px;font-family:"Plus Jakarta Sans",sans-serif;font-size:14px;color:#0D2542;background:#F8FAFC;outline:none;transition:all 0.2s;}
    .iw input::placeholder{color:#B8CCE0;}
    .iw input:focus{border-color:#1B3F6B;background:#fff;box-shadow:0 0 0 3px rgba(27,63,107,0.08);}
    .iw input:focus~i.ico,.iw:focus-within i.ico{color:#1B3F6B;}
    .eye-btn{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#B8CCE0;font-size:14px;padding:4px;transition:color 0.2s;}
    .eye-btn:hover{color:#1B3F6B;}

    .forgot{text-align:right;margin-top:-8px;margin-bottom:20px;}
    .forgot a{font-size:12px;font-weight:600;color:#1B3F6B;text-decoration:none;}
    .forgot a:hover{color:#C9A84C;}

    .btn-submit{
      width:100%;padding:13px;
      background:linear-gradient(135deg,#1B3F6B,#132E50);
      color:#fff;border:none;border-radius:10px;
      font-family:"Plus Jakarta Sans",sans-serif;
      font-size:14.5px;font-weight:700;
      cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
      box-shadow:0 4px 16px rgba(27,63,107,0.35);
      transition:all 0.2s;
      position:relative;overflow:hidden;
    }
    .btn-submit::after{
      content:"";position:absolute;bottom:0;left:0;right:0;height:2px;
      background:linear-gradient(90deg,transparent,#C9A84C,transparent);
    }
    .btn-submit:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(27,63,107,0.45);}
    .btn-submit:active{transform:translateY(0);}

    .hint{background:#F5F8FC;border:1px solid #DDE6F0;border-radius:9px;padding:10px 13px;display:flex;align-items:flex-start;gap:8px;margin-top:18px;}
    .hint i{color:#B8CCE0;font-size:12px;margin-top:2px;flex-shrink:0;}
    .hint p{font-size:11px;color:#94A3B8;line-height:1.5;}
    .hint code{font-family:"JetBrains Mono",monospace;font-size:10.5px;color:#1B3F6B;background:#EEF4FB;padding:1px 5px;border-radius:4px;}

    @media(max-width:860px){.lp{display:none;}.rp{width:100%;padding:40px 28px;}}
  </style>
</head>
<body>

<!-- PAINEL ESQUERDO -->
<div class="lp">
  <div class="dc dc1"></div><div class="dc dc2"></div><div class="dc dc3"></div>

  <div class="sf sf1">
    <div class="sf-ic" style="background:rgba(201,168,76,0.25);">🚗</div>
    <div><div class="sf-v">24</div><div class="sf-l">Veículos na frota</div></div>
  </div>
  <div class="sf sf2">
    <div class="sf-ic" style="background:rgba(5,150,105,0.25);">✅</div>
    <div><div class="sf-v">18</div><div class="sf-l">Contratos ativos</div></div>
  </div>
  <div class="sf sf3">
    <div class="sf-ic" style="background:rgba(201,168,76,0.2);">💰</div>
    <div><div class="sf-v">R$ 8.640</div><div class="sf-l">Receita mensal</div></div>
  </div>

  <!-- SVG Frota -->
  <div class="fleet-svg">
    <svg viewBox="0 0 460 290" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="240" width="460" height="50" fill="rgba(255,255,255,0.02)"/>
      <rect x="20"  y="261" width="44" height="5" rx="2.5" fill="rgba(201,168,76,0.15)"/>
      <rect x="100" y="261" width="44" height="5" rx="2.5" fill="rgba(201,168,76,0.15)"/>
      <rect x="180" y="261" width="44" height="5" rx="2.5" fill="rgba(201,168,76,0.15)"/>
      <rect x="260" y="261" width="44" height="5" rx="2.5" fill="rgba(201,168,76,0.15)"/>
      <rect x="340" y="261" width="44" height="5" rx="2.5" fill="rgba(201,168,76,0.15)"/>
      <!-- Carro principal -->
      <g transform="translate(136,140)">
        <ellipse cx="92" cy="94" rx="86" ry="8" fill="rgba(0,0,0,0.3)"/>
        <rect x="10" y="60" width="164" height="32" rx="6" fill="#132E50"/>
        <path d="M40 60 L56 26 Q61 20 72 20 L112 20 Q126 20 132 28 L148 60 Z" fill="#1B3F6B"/>
        <path d="M59 57 L66 24 L80 24 L76 57 Z" fill="rgba(201,168,76,0.4)"/>
        <path d="M80 57 L81 24 L103 24 L104 57 Z" fill="rgba(201,168,76,0.4)"/>
        <path d="M108 57 L108 24 L120 24 L126 57 Z" fill="rgba(201,168,76,0.4)"/>
        <rect x="10" y="67" width="20" height="11" rx="3" fill="#E8C96A"/>
        <rect x="10" y="67" width="20" height="11" rx="3" fill="rgba(232,201,106,0.7)"/>
        <rect x="154" y="67" width="20" height="11" rx="3" fill="#EF4444"/>
        <circle cx="47" cy="92" r="16" fill="#0D2542"/>
        <circle cx="47" cy="92" r="9"  fill="#1B3F6B"/>
        <circle cx="47" cy="92" r="4"  fill="#C9A84C"/>
        <circle cx="47" cy="92" r="1.5" fill="#0D2542"/>
        <circle cx="137" cy="92" r="16" fill="#0D2542"/>
        <circle cx="137" cy="92" r="9"  fill="#1B3F6B"/>
        <circle cx="137" cy="92" r="4"  fill="#C9A84C"/>
        <circle cx="137" cy="92" r="1.5" fill="#0D2542"/>
        <rect x="20" y="72" width="144" height="3" rx="1.5" fill="rgba(201,168,76,0.35)"/>
        <line x1="118" y1="20" x2="122" y2="6" stroke="rgba(201,168,76,0.3)" stroke-width="1.5"/>
        <circle cx="122" cy="5" r="2" fill="rgba(201,168,76,0.4)"/>
      </g>
      <!-- Carro verde esquerda -->
      <g transform="translate(16,165) scale(0.68)">
        <ellipse cx="90" cy="90" rx="82" ry="7" fill="rgba(0,0,0,0.2)"/>
        <rect x="8" y="56" width="164" height="30" rx="5" fill="#065F46"/>
        <path d="M38 56 L54 28 Q58 22 68 22 L114 22 Q126 22 130 30 L146 56 Z" fill="#059669"/>
        <path d="M57 53 L64 26 L78 26 L73 53 Z" fill="rgba(167,243,208,0.55)"/>
        <path d="M78 53 L79 26 L101 26 L102 53 Z" fill="rgba(167,243,208,0.55)"/>
        <path d="M106 53 L106 26 L118 26 L124 53 Z" fill="rgba(167,243,208,0.55)"/>
        <rect x="8" y="62" width="16" height="9" rx="3" fill="#FDE68A"/>
        <rect x="156" y="62" width="16" height="9" rx="3" fill="#EF4444"/>
        <circle cx="44"  cy="86" r="14" fill="#0D2542"/>
        <circle cx="44"  cy="86" r="8"  fill="#1B3F6B"/>
        <circle cx="136" cy="86" r="14" fill="#0D2542"/>
        <circle cx="136" cy="86" r="8"  fill="#1B3F6B"/>
      </g>
      <!-- Van dourada direita -->
      <g transform="translate(268,155) scale(0.76)">
        <ellipse cx="88" cy="92" rx="82" ry="7" fill="rgba(0,0,0,0.2)"/>
        <rect x="5" y="42" width="166" height="48" rx="5" fill="#92650A"/>
        <rect x="18" y="18" width="132" height="28" rx="4" fill="#A8892D"/>
        <rect x="24" y="22" width="30" height="20" rx="3" fill="rgba(255,237,180,0.5)"/>
        <rect x="62" y="22" width="30" height="20" rx="3" fill="rgba(255,237,180,0.5)"/>
        <rect x="100" y="22" width="30" height="20" rx="3" fill="rgba(255,237,180,0.5)"/>
        <rect x="5"  y="50" width="18" height="10" rx="3" fill="#E8C96A"/>
        <rect x="153" y="50" width="18" height="10" rx="3" fill="#EF4444"/>
        <circle cx="40"  cy="90" r="16" fill="#0D2542"/>
        <circle cx="40"  cy="90" r="9"  fill="#1B3F6B"/>
        <circle cx="40"  cy="90" r="4"  fill="#C9A84C"/>
        <circle cx="136" cy="90" r="16" fill="#0D2542"/>
        <circle cx="136" cy="90" r="9"  fill="#1B3F6B"/>
        <circle cx="136" cy="90" r="4"  fill="#C9A84C"/>
        <rect x="14" y="58" width="152" height="3" rx="1.5" fill="rgba(201,168,76,0.4)"/>
      </g>
      <!-- Roda / escudo dourado -->
      <g transform="translate(195,10)">
        <circle cx="38" cy="38" r="34" fill="rgba(201,168,76,0.1)" stroke="rgba(201,168,76,0.35)" stroke-width="1.5"/>
        <circle cx="38" cy="38" r="26" fill="none" stroke="rgba(201,168,76,0.2)" stroke-width="1"/>
        <circle cx="38" cy="38" r="8"  fill="none" stroke="rgba(201,168,76,0.3)" stroke-width="1.5"/>
        <circle cx="38" cy="38" r="3"  fill="rgba(201,168,76,0.5)"/>
        <line x1="38" y1="12" x2="38" y2="20" stroke="rgba(201,168,76,0.35)" stroke-width="2" stroke-linecap="round"/>
        <line x1="38" y1="56" x2="38" y2="64" stroke="rgba(201,168,76,0.35)" stroke-width="2" stroke-linecap="round"/>
        <line x1="12" y1="38" x2="20" y2="38" stroke="rgba(201,168,76,0.35)" stroke-width="2" stroke-linecap="round"/>
        <line x1="56" y1="38" x2="64" y2="38" stroke="rgba(201,168,76,0.35)" stroke-width="2" stroke-linecap="round"/>
      </g>
      <!-- Brilhos -->
      <circle cx="30"  cy="55"  r="2" fill="rgba(201,168,76,0.15)"/>
      <circle cx="420" cy="70"  r="2" fill="rgba(201,168,76,0.15)"/>
      <circle cx="398" cy="155" r="1.5" fill="rgba(255,255,255,0.08)"/>
      <circle cx="55"  cy="140" r="1.5" fill="rgba(255,255,255,0.08)"/>
    </svg>
  </div>

  <!-- Texto inferior -->
  <div class="lb">
    <img src="data:image/png;base64," alt="ZeloFrota" class="lb-logo">
    <div class="gold-line"></div>
    <div class="tagline">Sua frota sob<br><span>controle total.</span></div>
    <p class="desc">Gerencie veículos, aluguéis, inspeções e pagamentos em um único painel intuitivo.</p>
    <div class="feat-row">
      <div class="feat"><i class="fas fa-check-circle"></i> Check-in & Check-out</div>
      <div class="feat"><i class="fas fa-check-circle"></i> Controle de Pagamentos</div>
      <div class="feat"><i class="fas fa-check-circle"></i> Alertas de Vencimento</div>
    </div>
  </div>
</div>

<!-- PAINEL DIREITO -->
<div class="rp">
  <div class="fw">
    <img src="data:image/png;base64," alt="ZeloFrota" class="form-logo">
    <h1 class="form-title">Bem-vindo de volta!</h1>
    <p class="form-sub">Entre com suas credenciais para acessar o painel de controle da frota.</p>

    <% if(success_msg&&success_msg.length>0){ %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
    <% } %>
    <% if(error_msg&&error_msg.length>0){ %>
      <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle" style="flex-shrink:0;margin-top:1px;"></i>
        <div>
          <strong><%= error_msg %></strong>
          <% if(error_msg[0]&&error_msg[0].includes("banco")){ %>
          <p style="margin-top:6px;font-size:11px;opacity:0.85;">Verifique o PostgreSQL e o <code>.env</code>, depois rode <code>node setup.js</code></p>
          <% } %>
        </div>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="field">
        <label>E-mail</label>
        <div class="iw">
          <input type="email" name="email" placeholder="seu@email.com" required autocomplete="email">
          <i class="fas fa-envelope ico"></i>
        </div>
      </div>
      <div class="field">
        <label>Senha</label>
        <div class="iw">
          <input type="password" name="senha" id="sf" placeholder="••••••••" required autocomplete="current-password">
          <i class="fas fa-lock ico"></i>
          <button type="button" class="eye-btn" onclick="toggleSenha()" tabindex="-1">
            <i class="fas fa-eye" id="ei"></i>
          </button>
        </div>
      </div>
      <div class="forgot"><a href="/esqueci-senha">Esqueci minha senha</a></div>
      <button type="submit" class="btn-submit">
        <i class="fas fa-sign-in-alt"></i> Entrar no sistema
      </button>
    </form>

    <div class="hint">
      <i class="fas fa-info-circle"></i>
      <p>Login padrão: <code>admin@zelofrota.com</code> / <code>Admin@123</code></p>
    </div>
  </div>
</div>

<script>
function toggleSenha(){
  const i=document.getElementById("sf"),e=document.getElementById("ei");
  i.type=i.type==="password"?"text":"password";
  e.classList.toggle("fa-eye");e.classList.toggle("fa-eye-slash");
}
</script>
</body>
</html>