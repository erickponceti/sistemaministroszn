<%- include('../partials/header') %>

<div class="card-header" style="margin-bottom:20px">
  <div></div>
  <a href="/igrejas/nova" class="btn btn-primary"><i class="fas fa-plus"></i> Nova Igreja</a>
</div>

<% if (igrejas.length === 0) { %>
  <div class="card">
    <div class="empty-state">
      <i class="fas fa-church"></i>
      <p>Nenhuma igreja cadastrada ainda.</p>
      <a href="/igrejas/nova" class="btn btn-primary" style="margin-top:16px"><i class="fas fa-plus"></i> Cadastrar Igreja</a>
    </div>
  </div>
<% } else { %>
  <div class="card" style="padding:0">
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>Sigla</th>
            <th>Pastor Responsável</th>
            <th>Endereço</th>
            <th style="text-align:right">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% igrejas.forEach(ig => { %>
          <tr>
            <td><strong><%= ig.nome %></strong></td>
            <td><span class="badge badge-admin"><%= ig.sigla %></span></td>
            <td><%= ig.pastor_responsavel %></td>
            <td style="color:var(--text-light);font-size:13px"><%= ig.endereco || '—' %></td>
            <td style="text-align:right">
              <a href="/igrejas/<%= ig.id %>/editar" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
              <form action="/igrejas/<%= ig.id %>/deletar" method="POST" style="display:inline" onsubmit="return confirm('Remover esta igreja?')">
                <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
