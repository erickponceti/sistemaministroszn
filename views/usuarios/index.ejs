<%- include('../partials/header') %>

<% if (typeof erro !== 'undefined' && erro) { %>
<div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px;color:#991b1b;font-size:13px;font-weight:600">
  <i class="fas fa-exclamation-circle"></i>
  <%= erro %>
</div>
<% } %>

<div class="card-header" style="margin-bottom:20px">
  <div>
    <span style="font-size:13px;color:var(--text-light)">
      <i class="fas fa-users"></i>
      <strong style="color:var(--text-dark)"><%= usuarios.length %></strong> usuario(s) cadastrado(s)
    </span>
  </div>
  <a href="/usuarios/novo" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Usuario</a>
</div>

<!-- Legenda de perfis -->
<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px">
  <div style="display:flex;align-items:center;gap:6px;background:var(--primary-light);border-radius:8px;padding:6px 12px">
    <i class="fas fa-crown" style="color:var(--primary);font-size:12px"></i>
    <span style="font-size:12px;font-weight:700;color:var(--primary)">Administrador</span>
    <span style="font-size:11px;color:var(--accent-teal)">— Acesso total</span>
  </div>
  <div style="display:flex;align-items:center;gap:6px;background:#d1fae5;border-radius:8px;padding:6px 12px">
    <i class="fas fa-edit" style="color:#065f46;font-size:12px"></i>
    <span style="font-size:12px;font-weight:700;color:#065f46">Secretaria</span>
    <span style="font-size:11px;color:#10b981">— Agenda ministros, sem exclusoes ou aprovacoes</span>
  </div>
  <div style="display:flex;align-items:center;gap:6px;background:#ede9fe;border-radius:8px;padding:6px 12px">
    <i class="fas fa-eye" style="color:#5b21b6;font-size:12px"></i>
    <span style="font-size:12px;font-weight:700;color:#5b21b6">Somente Email</span>
    <span style="font-size:11px;color:#8b5cf6">— Apenas visualizacao</span>
  </div>
</div>

<% if (usuarios.length === 0) { %>
  <div class="card">
    <div class="empty-state">
      <i class="fas fa-users"></i>
      <p>Nenhum usuario cadastrado.</p>
    </div>
  </div>
<% } else { %>
<div class="card" style="padding:0">
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Perfil</th>
          <th>Status</th>
          <th>Cadastrado em</th>
          <th style="text-align:right">Acoes</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(function(u) {
          var perfilInfo = PERFIS.find(function(p){ return p.value===u.perfil; }) || { label: u.perfil };
          var perfilCss = u.perfil==='admin' ? 'background:var(--primary-light);color:var(--primary)' :
                          u.perfil==='secretaria' ? 'background:#d1fae5;color:#065f46' :
                          'background:#ede9fe;color:#5b21b6';
          var perfilIcon = u.perfil==='admin' ? 'fa-crown' :
                           u.perfil==='secretaria' ? 'fa-edit' : 'fa-eye';
          var dt = new Date(u.created_at);
          var dtStr = dt.toLocaleDateString('pt-BR');
          var ehEuMesmo = typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.id === u.id;
        %>
        <tr>
          <td>
            <div style="font-weight:700;font-size:14px">
              <%= u.nome %>
              <% if (ehEuMesmo) { %>
                <span style="font-size:10px;background:#fef3c7;color:#92400e;border-radius:10px;padding:2px 7px;margin-left:6px;font-weight:700">Voce</span>
              <% } %>
            </div>
          </td>
          <td style="color:var(--text-mid);font-size:13px"><%= u.email %></td>
          <td>
            <span style="display:inline-flex;align-items:center;gap:5px;border-radius:20px;padding:4px 12px;font-size:12px;font-weight:700;<%= perfilCss %>">
              <i class="fas <%= perfilIcon %>" style="font-size:11px"></i>
              <%= perfilInfo.label %>
            </span>
          </td>
          <td>
            <% if (u.ativo) { %>
              <span style="display:inline-flex;align-items:center;gap:4px;background:#d1fae5;color:#065f46;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:700">
                <i class="fas fa-check-circle"></i> Ativo
              </span>
            <% } else { %>
              <span style="display:inline-flex;align-items:center;gap:4px;background:#fee2e2;color:#991b1b;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:700">
                <i class="fas fa-ban"></i> Inativo
              </span>
            <% } %>
          </td>
          <td style="font-size:13px;color:var(--text-light)"><%= dtStr %></td>
          <td style="text-align:right">
            <a href="/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-outline">
              <i class="fas fa-edit"></i>
            </a>
            <% if (!ehEuMesmo) { %>
              <form action="/usuarios/deletar/<%= u.id %>" method="POST" style="display:inline"
                onsubmit="return confirm('Remover o usuario <%= u.nome %>?')">
                <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
