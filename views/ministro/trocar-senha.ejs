<%- include('header') %>

<div style="display:flex;align-items:center;justify-content:center;min-height:60vh">
  <div class="card" style="max-width:420px;width:100%">
    <div style="background:var(--primary);padding:24px;margin:-24px -24px 24px;border-radius:16px 16px 0 0;text-align:center">
      <i class="fas fa-shield-alt" style="font-size:36px;color:#fff;margin-bottom:10px"></i>
      <h2 style="color:#fff;font-size:18px;font-weight:900;margin:0">Definir Nova Senha</h2>
      <p style="color:rgba(255,255,255,.7);font-size:12px;margin-top:4px">Primeiro acesso — defina sua senha pessoal</p>
    </div>

    <% if (erro) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= erro %></div>
    <% } %>

    <form action="/ministro/trocar-senha" method="POST">
      <div class="form-group">
        <label class="form-label">Nova senha *</label>
        <div style="position:relative">
          <input type="password" name="senha" id="s1" class="form-control" placeholder="Minimo 6 caracteres" required autofocus style="padding-right:42px">
          <button type="button" onclick="tog('s1',this)" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-light)"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Confirmar senha *</label>
        <div style="position:relative">
          <input type="password" name="confirmar" id="s2" class="form-control" placeholder="Repita a senha" required style="padding-right:42px">
          <button type="button" onclick="tog('s2',this)" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-light)"><i class="fas fa-eye"></i></button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;padding:13px;font-size:15px">
        <i class="fas fa-check"></i> Salvar e Entrar
      </button>
    </form>
  </div>
</div>

<script>
function tog(id, btn) {
  var f = document.getElementById(id);
  f.type = f.type === 'password' ? 'text' : 'password';
  btn.innerHTML = f.type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
}
</script>

<%- include('footer') %>
